# CosmosVote Frontend environment
# Copy to .env.local and fill in your deployed contract IDs

# The network to connect to (e.g. testnet, mainnet)
VITE_NETWORK=testnet

# The Stellar contract ID for the Governance contract (starts with C, 56 characters)
VITE_GOVERNANCE_CONTRACT_ID=

# The Stellar contract ID for the Token contract (starts with C, 56 characters)
VITE_TOKEN_CONTRACT_ID=
# Optional: treasury contract address (leave blank if not deployed)
VITE_TREASURY_CONTRACT_ID=

# HTTPS origin of the separately deployed testnet faucet API (optional)
VITE_FAUCET_API_URL=

# Tally polling interval in milliseconds while a proposal is Active (default: 15000)
VITE_TALLY_POLL_INTERVAL=15000

# ─── Optional Configuration ───────────────────────────────────────────────────

# Admin address shown in the UI (optional, leave blank if not configured)
VITE_ADMIN_ADDRESS=

# Analytics: set to "true" to enable anonymous usage analytics (default: false)
VITE_ANALYTICS_ENABLED=false

# Analytics endpoint URL (only used when VITE_ANALYTICS_ENABLED=true)
VITE_ANALYTICS_ENDPOINT=

# Notification service URL for subscribing to on-chain event alerts (optional)
VITE_NOTIFICATION_SERVICE_URL=
