{
  "name": "cosmosvote-backend",
  "version": "1.0.0",
  "description": "CosmosVote off-chain notification and event-polling service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:faucet": "node dist/faucetServer.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage",
    "migrate:up": "ts-node src/migrate-cli.ts up",
    "migrate:down": "ts-node src/migrate-cli.ts down"
  },
  "dependencies": {
    "@sentry/node": "8.54.0",
    "@stellar/stellar-sdk": "12.3.0",
    "axios": "1.7.9",
    "better-sqlite3": "11.10.0",
    "helmet": "8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.5",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**"
    ]
  }
}