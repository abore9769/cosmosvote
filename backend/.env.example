# CosmosVote Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# Comma-separated list of allowed CORS origins (e.g. https://app.example.com,https://staging.example.com)
# Required in production. No wildcard is ever used.
ALLOWED_ORIGINS=https://your-frontend.example

# Sentry DSN for error tracking (leave blank to disable Sentry)
SENTRY_DSN=

# Application environment (development | staging | production)
NODE_ENV=development

# Application version reported to Sentry (e.g. git SHA or semver tag)
APP_VERSION=

# Structured JSON log level: trace | debug | info | warn | error | fatal
# Default: info
LOG_LEVEL=info

# Stellar RPC endpoint to poll for contract events
STELLAR_RPC_URL=http://localhost:8000

# Contract IDs to monitor
GOVERNANCE_CONTRACT_ID=
TOKEN_CONTRACT_ID=

# Webhook URL to deliver events to (e.g. your notification handler)
WEBHOOK_URL=

# How often to poll for new events (milliseconds, default 6000)
POLL_INTERVAL_MS=6000

# TCP port for the health-check HTTP server (/health and /ready endpoints)
# Default: 8080
HEALTH_PORT=8080

# Optional testnet token faucet API. Never use a mainnet admin key here.
FAUCET_ENABLED=false
FAUCET_PORT=3001
FAUCET_ALLOWED_ORIGIN=https://your-frontend.example
FAUCET_TOKEN_CONTRACT_ID=
FAUCET_ADMIN_SECRET_KEY=
FAUCET_RPC_URL=https://soroban-testnet.stellar.org
# Integer base units; 1000000000 is 100 VOTE when decimals are 7.
FAUCET_AMOUNT=1000000000
FAUCET_TOKEN_DECIMALS=7
# Mount durable storage at this path in production/container deployments.
FAUCET_DB_PATH=/data/faucet.sqlite

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# Maximum requests allowed within the rate-limit window (default: 100)
RATE_LIMIT_MAX=100

# Rate-limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite database path for local development (use FAUCET_DB_PATH for faucet data)
DATABASE_URL=
DB_PATH=
